

@{
    ViewData["Title"] = "Event Management";
    @if (User.IsInRole("HotelEmployee"))
    {
        ViewBag.LowerNavPartial = "_HotelManagementNavPartial";
    } else {
        ViewBag.LowerNavPartial = "_CustomerNavPartial";
    }
}


<h1>Event Management</h1>
<hr />


<div class="row justify-content-center my-4">

    <div class="text-center col-md-6 my-2">
        <a class="page-link text-dark" asp-action="StartMakingReservation">Create a new event reservation</a>
    </div>

    <div class="text-center col-md-6 my-2">
        <a class="page-link text-dark" asp-action="EventChoosing">Manage events</a>
    </div>

</div>

