@using HotelSystemIndustry.Infrastructure
@using Microsoft.AspNetCore.Identity

@inject SignInManager<User> SignInManager

@{
    ViewData["Title"] = "Zarządzanie wydarzeniami";
    ViewBag.LowerNavPartial = "_EventsNavPartial";
}


<h1>Zarządzanie wydarzeniami</h1>
<hr />


<div class="row justify-content-center my-4">

    <div class="text-center col-md-6 my-2">
        <a class="page-link text-dark" asp-action="StartMakingReservation">Stwórz nową rezerwację na wydarzenie</a>
    </div>

    @if (User.IsInRole("HotelEmployee")) {
        <div class="text-center col-md-6 my-2">
            <a class="page-link text-dark" asp-action="EventChoosing">Zarządzaj wydarzeniami</a>
        </div>
    }

</div>


@if (User.IsInRole("HotelEmployee")) {

    <h2>
    Zarządzanie
    </h2>

    <hr />

    <ul>
        <li>
            <a asp-controller="EventType" asp-action="Index">Typy wydarzeń</a>
        </li>

        <li>
            <a asp-controller="EventReservationStatus" asp-action="Index">Statusy wydarzeń</a>
        </li>

        <li>
            <a asp-controller="EquipmentType" asp-action="Index">Typy sprzętu</a>
        </li>

        <li>
            <a asp-controller="Equipment" asp-action="Index">Sprzęt</a>
        </li>

        <li>
            <a asp-controller="EquipmentInstance" asp-action="Index">Wystąpienia sprzętu</a>
        </li>

        <li>
            <a asp-controller="EventHall" asp-action="Index">Sale na wydarzenia</a>
        </li>

        <li>
            <a asp-controller="EventReservation" asp-action="Index">Rezerwacje</a>
        </li>
    </ul>
}


