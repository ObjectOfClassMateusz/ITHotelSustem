@using HotelSystemIndustry.Models.Events

@{
    ViewData["Title"] = "Choose event reservation";
    ViewBag.LowerNavPartial = "_HotelManagementNavPartial";

    var eventReservations = (IList<EventReservation>)ViewBag.EventReservations;
}


<h1>Choose event to manage</h1>
<hr />


<div class="container">

    <table class="table">
        <thead>
            <tr>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Name</th>
                <th>Event Type</th>
                <th>Event Status</th>
                <th>Number of guests</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var eventReservation in eventReservations) {
                <tr>
                    <td>@eventReservation.StartTime</td>
                    <td>@eventReservation.EndTime</td>
                    <td>@eventReservation.Name</td>
                    <td>@eventReservation.EventType?.Name</td>
                    <td>@eventReservation.Status?.Name</td>
                    <td>@eventReservation.NumGuests</td>
                    <td>
                        <a class="btn btn-success" asp-action="EventRealisation" asp-route-id="@eventReservation.Id">Manage</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="my-4">
        <a class="btn btn-primary" asp-action="Index">Back</a>
    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
