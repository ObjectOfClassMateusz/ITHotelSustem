@using HotelSystemIndustry.Models.Events

@{
    ViewData["Title"] = "Wybierz rezerwację na wydarzenie";
    ViewBag.LowerNavPartial = "_EventsNavPartial";

    var eventReservations = (IList<EventReservation>)ViewBag.EventReservations;
}


<h1>Wybierz wydarzenie, którym chcesz zarządzać</h1>
<hr />


<div class="container">

    <table class="table">
        <thead>
            <tr>
                <th>Czas rozpoczęcia</th>
                <th>Czas zakończenia</th>
                <th>Nazwa</th>
                <th>Typ</th>
                <th>Status</th>
                <th>Liczba gości</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var eventReservation in eventReservations) {
                <tr>
                    <td>@eventReservation.StartTime</td>
                    <td>@eventReservation.EndTime</td>
                    <td>@eventReservation.Name</td>
                    <td>@eventReservation.EventType?.Name</td>
                    <td>@eventReservation.Status?.Name</td>
                    <td>@eventReservation.NumGuests</td>
                    <td>
                        <a class="btn btn-success" asp-action="EventRealisation" asp-route-id="@eventReservation.Id">Zarządzaj</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="my-4">
        <a class="btn btn-primary" asp-action="Index">Wróć</a>
    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
