@model HotelSystemIndustry.Models.Kitchen.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SubmissionTime)
        </dt>
        <dd class = "col-sm-10">
            @{ var submissionTime = Model.SubmissionTime.ToLocalTime(); }
            @Html.DisplayFor(modelItem => submissionTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RealisedTime)
        </dt>
        <dd class = "col-sm-10">
            @{
                var realisedTime = Model.RealisedTime;
                if (realisedTime != null)
                    realisedTime = realisedTime.Value.ToLocalTime();
            }
            @Html.DisplayFor(model => realisedTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DeliveryDestination)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeliveryDestination)
        </dd>
    </dl>

    <h5>Products</h5>
    <hr />
    @Html.DisplayFor(model => model.Products)
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
