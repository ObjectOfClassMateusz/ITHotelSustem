@model IEnumerable<HotelSystemIndustry.Models.Kitchen.Order>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-controller="Kitchen" asp-action="PlaceOrder">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SubmissionTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RealisedTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hotel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeliveryDestination)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @{ var submissionTime = item.SubmissionTime.ToLocalTime(); }
                @Html.DisplayFor(modelItem => submissionTime)
            </td>
            <td>
                @{
                    var realisedTime = item.RealisedTime;
                    if (realisedTime != null)
                        realisedTime = realisedTime.Value.ToLocalTime();
                }
                @Html.DisplayFor(modelItem => realisedTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hotel!.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryDestination)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
