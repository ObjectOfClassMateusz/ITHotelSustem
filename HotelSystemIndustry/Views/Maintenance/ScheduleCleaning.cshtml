@{
    ViewData["Title"] = "Zaplanuj Sprzątanie";
    ViewBag.LowerNavPartial = "_MaintenanceNavPartial";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-6 mx-auto">
        <div class="card-body p-4">
            <h4 class="mb-3">Zaplanuj sprzątanie</h4>
            <hr />
            <form asp-action="ScheduleCleaning" method="post">
                <div class="form-group mb-3">
                    <label class="control-label font-weight-bold">Pokój</label>
                    <select name="roomId" class="form-control" asp-items="ViewBag.RoomsSelectList">
                        <option value="">-- Wybierz pokój --</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label class="control-label font-weight-bold">Pracownik (aktywne zmiany)</label>
                    <select name="employeeEmail" class="form-control" asp-items="ViewBag.ShiftsSelectList">
                        <option value="">-- Wybierz pracownika --</option>
                    </select>
                </div>
                <div class="form-group mb-4">
                    <label class="control-label font-weight-bold">Data i godzina</label>
                    <input type="datetime-local" name="scheduledDate" class="form-control" />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="CleaningList" class="btn btn-outline-secondary">Powrót</a>
                    <button type="submit" class="btn btn-primary">Zaplanuj</button>
                </div>
            </form>
        </div>
    </div>
</div>