@model HotelSystemIndustry.Models.Recreation.RecreationBooking

@{
    ViewData["Title"] = "Book Facility";
    ViewBag.LowerNavPartial = "_RecreationNavPartial";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-body p-4">
            <h3 class="text-center mb-4"> Rezerwuj Obiekt: <span class="text-primary">@ViewBag.FacilityName</span></h3>
            <hr />

            <form asp-action="Book" method="post">
                <input type="hidden" asp-for="FacilityId" value="@ViewBag.FacilityId" />

                <div class="form-group mb-3">
                    <label asp-for="GuestId" class="control-label font-weight-bold">Wybierz Gościa</label>
                    <select asp-for="GuestId" class="form-control" asp-items="ViewBag.GuestsSelectList">
                        <option value="">-- Gość --</option>
                    </select>
                    <span asp-validation-for="GuestId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="StartTime" class="control-label font-weight-bold">Czas startowy</label>
                        @* datetime-local -> kalendarz z zegarem *@
                        <input asp-for="StartTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-4">
                        <label asp-for="EndTime" class="control-label font-weight-bold">Czas Końcowy</label>
                        <input asp-for="EndTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="FacilityList" class="btn btn-outline-secondary">Powrót do Listy</a>
                    <button type="submit" class="btn btn-success px-4">Potwierdź Rezerwacje</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}