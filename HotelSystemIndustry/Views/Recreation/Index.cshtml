@{
    ViewData["Title"] = "Panel Rekreacji";
    ViewBag.LowerNavPartial = "_RecreationNavPartial";
}

<div class="container mt-4">
    <h1 class="text-center">Centrum Rekreacji</h1>
    <hr />

    <div class="row justify-content-center mt-5">
        
        <div class="col-md-4 text-center my-2">
            <div class="card shadow-sm">
                <div class="card-body py-5">
                    <h4>Oferta Rekreacji</h4>
                    <p class="text-muted">Przeglądaj rekreacje i zarezerwuj odpowiednią date.</p>
                    <a asp-action="FacilityList" class="btn btn-primary w-100">Sprawdź listę obiektów</a>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("RecreationEmployee"))
        {
            <div class="col-md-4 text-center my-2">
                <div class="card shadow-sm bg-light">
                    <div class="card-body py-5">
                        <h4>Zarządzaj Obiektami</h4>
                        <p class="text-muted">Dodaj nowy obiekt - nowa rekreacja</p>
                        <a asp-action="CreateFacility" class="btn btn-warning w-100">Panel Dodawania obiektów</a>
                    </div>
                </div>
            </div>
        }

    </div>
    <hr />
    <form id="hotelchangeform" class="form-group row my-4 justify-content-center">
        <div class="col-md-1">
            <label class="control-label" for="hotelid">Hotel:</label>
        </div>
        <div class="col-md-4">
            <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
        </div>
    </form>

    @section Scripts {
        <script type="text/javascript">
                $(document).ready(function () {
                    $("#hotelid").change(function (e) {
                        e.preventDefault();
                        let data = new FormData();
                        data.append("hotelid", $("#hotelid").val());
                        $.ajax({
                            url: '/HotelChange/ChangeHotel',
                            type: "POST",
                            processData: false,
                            data: data,
                            dataType: 'json',
                            contentType: false,
                            success: function (response) {location.reload();},
                            error: function (er) { console.log(er); }
                        });
                        return false;
                    });
                });
        </script>
    }
</div>