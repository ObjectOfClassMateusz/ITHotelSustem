@{
    ViewData["Title"] = "Dashboard";
    ViewBag.LowerNavPartial = "_HousekeepingNavPartial";
}

<div class="container mt-4">
    <h2>Witaj, @ViewBag.EmployeeName</h2>
    <p class="text-muted">Twoje zadania na dziś</p>
    <hr />

    @if (ViewBag.MyCleanings == null || ((List<HotelSystemIndustry.Models.HousekeepingMaintenance.RoomCleaning>)ViewBag.MyCleanings).Count == 0)
    {
        <div class="alert alert-info">Nie masz żadnych zadań na dziś.</div>
    }
    else
    {
        <table class="table table-hover bg-white shadow-sm">
            <thead class="thead-light">
                <tr>
                    <th>Pokój</th>
                    <th>Piętro</th>
                    <th>Zaplanowane na</th>
                    <th>Status</th>
                    <th class="text-center">Akcja</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cleaning in (List<HotelSystemIndustry.Models.HousekeepingMaintenance.RoomCleaning>)ViewBag.MyCleanings)
                {
                    <tr>
                        <td class="align-middle">Pokój @cleaning.Room.RoomNumber</td>
                        <td class="align-middle">Piętro @cleaning.Room.Floor</td>
                        <td class="align-middle">@cleaning.ScheduledDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="align-middle">
                            @if (cleaning.Status == HotelSystemIndustry.Models.HousekeepingMaintenance.CleaningStatus.SCHEDULED)
                            {
                                <span class="badge" style="background-color:#ffc107; color:black;">Zaplanowane</span>
                            }
                            else if (cleaning.Status == HotelSystemIndustry.Models.HousekeepingMaintenance.CleaningStatus.IN_PROGRESS)
                            {
                                <span class="badge" style="background-color:#0d6efd; color:white;">W trakcie</span>
                            }
                        </td>
                        <td class="align-middle text-center">
                            @if (cleaning.Status == HotelSystemIndustry.Models.HousekeepingMaintenance.CleaningStatus.SCHEDULED)
                            {
                                <form asp-action="StartCleaning" asp-route-id="@cleaning.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-primary">Rozpocznij</button>
                                </form>
                            }
                            else if (cleaning.Status == HotelSystemIndustry.Models.HousekeepingMaintenance.CleaningStatus.IN_PROGRESS)
                            {
                                <a asp-action="CompleteCleaning" asp-route-id="@cleaning.Id" class="btn btn-sm btn-success">Zakończ</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <hr />
    <form id="hotelchangeform" class="form-group row my-4 justify-content-center">
        <div class="col-md-1">
            <label class="control-label" for="hotelid">Hotel:</label>
        </div>
        <div class="col-md-4">
            <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
        </div>
    </form>

    @section Scripts {
        <script type="text/javascript">
                $(document).ready(function () {
                    $("#hotelid").change(function (e) {
                        e.preventDefault();
                        let data = new FormData();
                        data.append("hotelid", $("#hotelid").val());
                        $.ajax({
                            url: '/HotelChange/ChangeHotel',
                            type: "POST",
                            processData: false,
                            data: data,
                            dataType: 'json',
                            contentType: false,
                            success: function (response) {location.reload();},
                            error: function (er) { console.log(er); }
                        });
                        return false;
                    });
                });
        </script>
    }
</div>