@{
    ViewData["Title"] = "Zgłoś Usterkę";
    ViewBag.LowerNavPartial = "_HousekeepingNavPartial";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-6 mx-auto">
        <div class="card-body p-4">
            <h4 class="mb-3">Zgłoś usterkę</h4>
            <hr />

            <form asp-action="ReportMaintenance" method="post">
                <div class="form-group mb-3">
                    <label class="control-label font-weight-bold">Pokój</label>
                    <select name="roomId" class="form-control" asp-items="ViewBag.RoomsSelectList">
                        <option value="">-- Wybierz pokój --</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label font-weight-bold">Opis usterki</label>
                    <textarea name="description" class="form-control" rows="4" placeholder="Opisz usterkę..."></textarea>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label font-weight-bold">Priorytet</label>
                    <select name="priority" class="form-control">
                        <option value="0">Niski</option>
                        <option value="1">Średni</option>
                        <option value="2">Wysoki</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Powrót</a>
                    <button type="submit" class="btn btn-danger">Zgłoś usterkę</button>
                </div>
            </form>
        </div>
    </div>
</div>