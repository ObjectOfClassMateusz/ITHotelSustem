@using HotelSystemIndustry.Models.Trading
@using HotelSystemIndustry.ViewModels.Trading

@model AcceptTradingDeliveryViewModel

@{
    ViewData["Title"] = "Zaakceptuj dostawę";
    ViewBag.LowerNavPartial = "_TradingNavPartial";

    var items = (IList<SaleItem>)ViewBag.Items;
    var itemInstances = (IList<SaleItemInstance>)ViewBag.ItemInstances;
    var magazines = (IList<ShopMagazine>)ViewBag.Magazines;
}

<h1>Zaakceptuj dostawę</h1>
<hr />


<div class="container">

    @if (Model.Items.Count > 0) {
        <div>
            <h2 class="my-4">Dostarczone przedmioty</h2>

            <ul>
                @foreach (var item in Model.Items) {
                    var saleItem = items.FirstOrDefault(si => si.Id == item.SaleItemId);
                    var magazine = magazines.FirstOrDefault(m => m.Id == item.MagazineId);

                    @if (string.IsNullOrEmpty(item.Variant)) {
                        <li><span class="fw-bold">@saleItem!.Name</span> x @item.Count do <span class="fw-bold">@magazine!.Location</span> – @Html.DisplayFor(m => item.Price)</li>
                    } else {
                        <li><span class="fw-bold">@saleItem!.Name</span> (@item.Variant) x @item.Count do <span class="fw-bold">@magazine!.Location</span> – @Html.DisplayFor(m => item.Price)</li>
                    }
                }
            </ul>
        </div>

        <hr />
    }

    <form method="post" asp-action="AddDeliveryItem">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @for (var i = 0 ; i < Model.Items.Count; i++) {
            @Html.HiddenFor(m => m.Items[i].SaleItemId)
            @Html.HiddenFor(m => m.Items[i].Variant)
            @Html.HiddenFor(m => m.Items[i].Count)
            @Html.HiddenFor(m => m.Items[i].Price)
            @Html.HiddenFor(m => m.Items[i].MagazineId)
            @Html.HiddenFor(m => m.Items[i].ExpireDate)
        }

        <h2 class="my-4">Dodaj przedmiot</h2>

        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.SaleItemId" class="control-label">Przedmiot:</label>
            </div>
            <div class="col-md-4">
                <select asp-items="ViewBag.ItemSelectList" asp-for="NewItem.SaleItemId" class="form-control"></select>
            </div>
            <span asp-validation-for="NewItem.SaleItemId" class="text-danger"></span>
        </div>
        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.Variant" class="control-label">Wariant przedmiotu:</label>
            </div>
            <div class="col-md-4">
                <input type="text" asp-for="NewItem.Variant" class="form-control" placeholder="Wprowadź tutaj opis wariantu…" />
            </div>
            <span asp-validation-for="NewItem.Variant" class="text-danger"></span>
        </div>
        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.ExpireDate" class="control-label">Data ważności:</label>
            </div>
            <div class="col-md-4">
                <input asp-for="NewItem.ExpireDate" class="form-control" />
            </div>
            <span asp-validation-for="NewItem.ExpireDate" class="text-danger"></span>
        </div>
        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.Count" class="control-label">Ilość przedmiotu:</label>
            </div>
            <div class="col-md-4">
                <input type="number" value="1" asp-for="NewItem.Count" class="form-control" />
            </div>
            <span asp-validation-for="NewItem.Count" class="text-danger"></span>
        </div>
        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.Price" class="control-label">Cena jednostkowa:</label>
            </div>
            <div class="col-md-4">
                <input type="number" asp-for="NewItem.Price" class="form-control" />
            </div>
            <span asp-validation-for="NewItem.Price" class="text-danger"></span>
        </div>
        <div class="form-group row my-2">
            <div class ="col-md-2">
                <label asp-for="NewItem.MagazineId" class="control-label">Do magazynu:</label>
            </div>
            <div class="col-md-4">
                <select asp-items="ViewBag.MagazineSelectList" asp-for="NewItem.MagazineId" class="form-control"></select>
            </div>
            <span asp-validation-for="NewItem.MagazineId" class="text-danger"></span>
        </div>

        <input type="submit" class="btn btn-primary my-2" value="Dodaj" />
    </form>

    <form method="post" asp-action="SubmitDelivery" class="my-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @for (var i = 0 ; i < Model.Items.Count; i++) {
            @Html.HiddenFor(m => m.Items[i].SaleItemId)
            @Html.HiddenFor(m => m.Items[i].Variant)
            @Html.HiddenFor(m => m.Items[i].Count)
            @Html.HiddenFor(m => m.Items[i].Price)
            @Html.HiddenFor(m => m.Items[i].MagazineId)
            @Html.HiddenFor(m => m.Items[i].ExpireDate)
        }

        <input type="submit" class="btn btn-success" value="Zatwierdź" />
    </form>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}


