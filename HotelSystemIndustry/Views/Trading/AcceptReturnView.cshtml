@using HotelSystemIndustry.Models.Trading

@{
    ViewData["Title"] = "Przyjmij zwrot wypożyczonego przedmiotu";
    ViewBag.LowerNavPartial = "_TradingNavPartial";

    var items = (IList<PurchaseItem>)ViewBag.Items;
}

<h1>Przyjmij zwrot</h1>
<hr />


<div class="container my-4">

    <h3>Wypożyczone przedmioty, które nie zostały jeszcze zwrócone</h3>

    @if (items.Count > 0) {
    
        <table class="table">
            <thead>
                <tr>
                    <th>Przedmiot</th>
                    <th>Wariant</th>
                    <th>Ilość</th>
                    <th>Cena jednostkowa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items) {
                    <tr>
                        <td>@item.SaleItem!.Name</td>
                        <td>@item.Variant</td>
                        <td>@item.Count</td>
                        <td>@item.UnitPrice.ToString("C2")</td>
                        <td>
                            
                            <form method="get" asp-action="ReturnItemMenu" asp-route-purchaseItemId="@item.Id" >

                                <input type="submit" class="btn btn-success" value="Zwróć" />
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    } else {
        <span>Nie ma żadnych wypożyczonych, niezwróconych przedmiotów.</span>
    }

</div>

<a asp-action="Index" class="btn btn-primary">Wróć</a>

