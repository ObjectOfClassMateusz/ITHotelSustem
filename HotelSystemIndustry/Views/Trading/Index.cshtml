
@{
    ViewData["Title"] = "Trading";
    ViewBag.LowerNavPartial = "_TradingNavPartial";
}


<h1>Shop</h1>


<div class="row justify-content-center my-4">

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="SellOrRentItemsView">Sell/rent items</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="AcceptReturnView">Accept return</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="AcceptDeliveryView">Accept delivery</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="PruneExpiredItems">Prune expired items</a>
    </div>

</div>


<hr />


<form id="hotelchangeform" class="form-group row my-4 justify-content-center">

    <div class="col-md-1">
        <label class="control-label fs-6" for="hotelid">Hotel:</label>
    </div>
    <div class="col-md-4">
        <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
    </div>

</form>


<h2>Management</h2>

<hr />


<ul>
    <li>
        <a asp-controller="SaleItemType" asp-action="Index">Types of items to sell</a>
    </li>

    <li>
        <a asp-controller="SaleItem" asp-action="Index">Items to sell</a>
    </li>

    <li>
        <a asp-controller="SaleItemInstance" asp-action="Index">Instances of items to sell</a>
    </li>
    
    <li>
        <a asp-controller="Purchase" asp-action="Index">Purchases</a>
    </li>
</ul>


@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#hotelid").change(function (e){
                e.preventDefault();
                let data = new FormData();
                data.append("hotelid", $("#hotelid").val());
                $.ajax({
                    url: '/HotelChange/ChangeHotel',
                    type: "POST",
                    processData: false,
                    data: data,
                    dataType: 'json',
                    contentType: false,
                    success: function (response) {
                        console.log('Changed hotel');
                    },
                    error: function (er) { console.log(er); }
                });

                return false;
            });
        });
    </script>
}

