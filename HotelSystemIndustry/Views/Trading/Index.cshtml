
@{
    ViewData["Title"] = "Moduł sprzedaży";
    ViewBag.LowerNavPartial = "_TradingNavPartial";
}


<h1>Sprzedaż</h1>


<div class="row justify-content-center my-4">

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="SellOrRentItemsView">Sprzedaj/wypożycz przedmioty</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="AcceptReturnView">Przyjmij zwrot wypożyczonego przedmiotu</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="AcceptDeliveryView">Zaakceptuj dostawę</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a class="page-link text-dark" asp-action="PruneExpiredItems">Pozbądź się przeterminowanych przedmiotów</a>
    </div>

</div>


<hr />


<form id="hotelchangeform" class="form-group row my-4 justify-content-center">

    <div class="col-md-1">
        <label class="control-label fs-6" for="hotelid">Hotel:</label>
    </div>
    <div class="col-md-4">
        <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
    </div>

</form>


<h2>Zarządzanie</h2>

<hr />


<ul>
    <li>
        <a asp-controller="SaleItemType" asp-action="Index">Typy przedmiotów na sprzedaż</a>
    </li>

    <li>
        <a asp-controller="SaleItem" asp-action="Index">Przedmioty na sprzedaż</a>
    </li>

    <li>
        <a asp-controller="SaleItemInstance" asp-action="Index">Wystąpienia przedmiotów na sprzedaż</a>
    </li>

    <li>
        <a asp-controller="ShopMagazine" asp-action="Index">Magazyny</a>
    </li>

    <li>
        <a asp-controller="ShopPoint" asp-action="Index">Punkty sprzedaży</a>
    </li>
    
    <li>
        <a asp-controller="Purchase" asp-action="Index">Zakupy</a>
    </li>
</ul>


@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#hotelid").change(function (e){
                e.preventDefault();
                let data = new FormData();
                data.append("hotelid", $("#hotelid").val());
                $.ajax({
                    url: '/HotelChange/ChangeHotel',
                    type: "POST",
                    processData: false,
                    data: data,
                    dataType: 'json',
                    contentType: false,
                    success: function (response) {
                        console.log('Changed hotel');
                    },
                    error: function (er) { console.log(er); }
                });

                return false;
            });
        });
    </script>
}

