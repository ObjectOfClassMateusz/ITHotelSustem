@using HotelSystemIndustry.Models.Trading
@using HotelSystemIndustry.ViewModels.Trading
@model SellOrRentItemsViewModel

@{
    ViewData["Title"] = "Sprzedaj/wypożycz przedmioty";
    ViewBag.LowerNavPartial = "_TradingNavPartial";

    var Items = (IList<SaleItemInstance>)ViewBag.SaleItemInstances;
}

<h1>Sprzedaj/wypożycz przedmioty</h1>
<hr />

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="form-group row">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Items.MagazineId, "Magazyn: ", new {@class = "control-label"})
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.Items.MagazineId, (IEnumerable<SelectListItem>)ViewBag.MagazineList, new {@class = "form-control"})
        </div>
        <div class="col-md-1">
            <input type="submit" asp-action="RefreshSaleOrRentItemsView" class="btn btn-primary text-end" value="Odśwież listę" />
        </div>
        <span asp-validation-for="Items.MagazineId" class="text-danger"></span>
    </div>
    <div class="form-group row">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Items.ShopPointId, "Punkt sprzedażowy: ", new {@class = "control-label"})
        </div>
        <div class="col-md-5">
            @Html.DropDownListFor(m => m.Items.ShopPointId, (IEnumerable<SelectListItem>)ViewBag.ShopPointList, new {@class = "form-control"})
        </div>
        <span asp-validation-for="Items.ShopPointId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="form-group row justify-content-center my-4">
                @foreach (var item in Items) {
                    if (item.MagazineId != Model.Items.MagazineId)
                        continue;
                    
                    var countAfterPurchase = (int)item.Count;
                    var currentItem = Model.Items.Items.FirstOrDefault(a => a.SaleItemInstanceId == item.Id);
                    if (currentItem != null)
                        countAfterPurchase -= (int)currentItem.Count;
                    
                    // Skip items that are all already in the cart
                    if (countAfterPurchase <= 0)
                        continue;

                    if (item.ExpireDate != null)
                    {
                        // Skip expired items
                        if (DateTime.UtcNow.Date > item.ExpireDate.Value.Date)
                            continue;
                    }

                    <div class="container my-2">
                        <input type="radio" asp-for="NewItemId" value="@item.Id" id="Item(@item.Id)" class="radiobutton-box" />
                        <label for="Item(@item.Id)" class="row mx-0">
                            <div class="col-md-3 text-start">@item.Item!.Name</div>
                            <div class="col-md-3 text-start">@item.Variant</div>
                            <div class="col-md-2 text-start">x @countAfterPurchase</div>
                            <div class="col-md-12 text-end">@Html.DisplayFor(m => item.Price)</div>
                        </label>
                        <span asp-validation-for="NewItemId" class="text-danger"></span>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            @if (Model.Items.Items.Count > 0) {
                decimal totalPrice = 0;

                <ul>
                    @for (var i = 0; i < Model.Items.Items.Count; i++) {
                        <li>
                            @Html.HiddenFor(m => m.Items.Items[i].SaleItemInstanceId)
                            @Html.HiddenFor(m => m.Items.Items[i].Count)
                            @{
                                var id = Model.Items.Items[i].SaleItemInstanceId;
                                var count = Model.Items.Items[i].Count;
                                var item = Items.Single(p => p.Id == id);

                                var itemPrice = item.Price * count;
                                totalPrice += itemPrice;

                                <div class="row align-items-center">
                                    <div class="col-md-7 text-start">@item.Item!.Name x @count</div> <div class="col-md-3 text-end">@itemPrice.ToString("C2")</div>

                                    <div class="col-md-1 my-1"><input type="submit" asp-action="RemoveSaleItem" class="btn btn-danger" value="x" asp-route-index="@i" /></div>
                                </div>
                            }
                        </li>
                    }
                </ul>

                <hr />
                <div class="row mx-2">
                    <div class="col-md-8 text-start">Razem: </div> <div class="col-md-3 text-end">@totalPrice.ToString("C2")</div>
                </div>
            }
        </div>
    </div>

    <div class="form-group row my-4">
        <div class="col-md-2">
            <input min="1" max="5" step="1" value="1" asp-for="NewItemCount" class="form-control" />
        </div>

        <div class="col-md-1">
            <input type="submit" asp-action="AddSaleItem" class="btn btn-primary" value="Dodaj przedmiot" />
        </div>

        <span asp-validation-for="NewItemCount" class="text-danger"></span>
    </div>

    <input type="submit" class="btn btn-success my-4" value="Zatwierdź" asp-action="VerifyPurchase" />

</form>

<div class="my-4">
    <a asp-action="Index">Wróć</a>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}

