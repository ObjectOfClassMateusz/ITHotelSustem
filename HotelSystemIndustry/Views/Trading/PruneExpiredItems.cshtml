@using HotelSystemIndustry.Models.Trading

@{
    ViewData["Title"] = "Pozbądź się przeterminowanych przedmiotów";
    ViewBag.LowerNavPartial = "_TradingNavPartial";

    var expiredItems = (IList<SaleItemInstance>)ViewBag.ExpiredItems;
}

<h1>Pozbądź się przeterminowanych przedmiotów</h1>
<hr />


@if (expiredItems.Count == 0) {

    <h2>Nie ma żadnych przeterminowanych przedmiotów do wyczyszczenia!</h2>
    <div class="my-4">Hura!</div>

} else {
    <h2 class="my-4">Poniższe przedmioty są przeterminowane:</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Przedmiot</th>
                <th>Wariant</th>
                <th>Ilość</th>
                <th>W magazynie</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in expiredItems) {
                <tr>
                    <td>@item.Item!.Name</td>
                    <td>@item.Variant</td>
                    <td>@item.Count</td>
                    <td>@item.Magazine!.Location</td>
                </tr>
            }

        </tbody>
    </table>

    <form method="post" asp-action="ConfirmExpiredItemsPrunning">
        @Html.AntiForgeryToken()

        <div class="form-group my-4">
            Proszę pozbyć się tych przedmiotów z magazynów, w których się znajdują, a następnie potwierdzić operację.
            <input type="submit" class="btn btn-danger mx-4" value="Potwierdź czyszczenie" />
        </div>
    </form>
}

<a asp-action="Index" class="btn btn-primary">Wróć</a>

