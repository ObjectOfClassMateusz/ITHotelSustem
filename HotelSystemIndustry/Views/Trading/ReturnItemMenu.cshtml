@using HotelSystemIndustry.Models.Trading

@{
    ViewData["Title"] = "Zwróć przedmiot";
    ViewBag.LowerNavPartial = "_TradingNavPartial";

    var purchaseItem = (PurchaseItem)ViewBag.PurchaseItem;
    var saleItemInstances = (IList<SaleItemInstance>)ViewBag.SaleItemInstances;
    var magazineSelectList = (IEnumerable<SelectListItem>)ViewBag.MagazineSelectList;
}

<h1>Zwróć wypożyczony przedmiot</h1>
<hr />


<div class="container">
    <h3>@purchaseItem.SaleItem!.Name</h3>
    <dl>
        <div class="row">
            <dt class="col-sm-2">Wariant</dt>
            <dd class="col-sm-6">@purchaseItem.Variant</dd>
        </div>
        <div class="row">
            <dt class="col-sm-2">Ilość</dt>
            <dd class="col-sm-6">@purchaseItem.Count</dd>
        </div>
        <div class="row">
            <dt class="col-sm-2">Cena jednostkowa</dt>
            <dd class="col-sm-6">@Html.DisplayFor(m => purchaseItem.UnitPrice)</dd>
        </div>
    </dl>

    @if (saleItemInstances.Count > 0) {
        <h2>Magazyny, w których ten sam przedmiot jest przechowywany</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Magazyn</th>
                    <th>Ilość</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instance in saleItemInstances) {
                    <tr>
                        <td>@instance.Magazine!.Location</td>
                        <td>x @instance.Count</td>
                        <td>
                            <form method="post" asp-action="ConfirmItemReturn">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PurchaseItemId" value="@purchaseItem.Id" />
                                <input type="hidden" name="MagazineId" value="@instance.MagazineId" />
                                <input type="submit" class="btn btn-success" value="Zwróć tutaj" />
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        if (magazineSelectList.Count() > 0) {
            <h3>…lub zabierz do innego magazynu</h3>
        }
    } else if (magazineSelectList.Count() > 0) {
        <h3>Wybierz magazyn, w którym będzie przechowywany przedmiot</h3>
    } else {
        <h3>Brak dostępnych magazynów!</h3>
    }

    @if (magazineSelectList.Count() > 0) {
        <form method="post" asp-action="ConfirmItemReturn">
            @Html.AntiForgeryToken()

            <input type="hidden" name="PurchaseItemId" value="@purchaseItem.Id" />
            
            <div class="form-group row my-4">
                <div class="col-md-6">
                    <select asp-items="@magazineSelectList" name="MagazineId" class="form-control"></select>
                </div>
                <div class="col-md-2">
                    <input type="submit" class="btn btn-success" value="Zwróć tutaj" />
                </div>
            </div>
        </form>
    }

</div>


<a asp-action="AcceptReturnView" class="btn btn-primary">Wróć</a>

