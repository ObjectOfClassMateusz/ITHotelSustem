@using HotelSystemIndustry.Infrastructure
@using Microsoft.AspNetCore.Identity

@model IEnumerable<HotelSystemIndustry.Models.Hotel>

@{
    ViewData["Title"] = "Hotel System Industry";
}

@inject SignInManager<User> SignInManager

<center>
    <h1>Hotele zarejestrowane w systemie</h1>
</center>

<a class="add-hotel-btn" asp-action="Create">
</a>

<div class="hotel-container-flex">
    @foreach (var item in Model)
    {
        <div class="hotel-element-flex">
            <b>@item.Name</b>
            <p>@item.Description</p>
            <div class="details-center-flex">
                @if (User.IsInRole("HotelEmployee"))
                {

                    <a class="asp-link" asp-action="Calendar" asp-route-id="@item.Id">
                        Szczegóły
                    </a>
                }
                else
                {
                    <a class="asp-link" asp-action="Details" asp-route-id="@item.Id">
                        Szczegóły
                    </a>
                }
            </div>
        </div>
    }
</div>