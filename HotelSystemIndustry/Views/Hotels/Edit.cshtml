@model HotelSystemIndustry.Models.Hotel
@{
    ViewData["Title"] = "Edytuj — " + Model.Name;
}

<style>
    import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap');

    :root {
        --bg: #f2ede4;
        --surface: #ffffff;
        --ink: #1a1712;
        --gold: #a07830;
        --gold-lt: #c49a50;
        --gold-pale: #f0e4cc;
        --muted: #7a7060;
        --rule: #ddd6c4;
        --danger: #b03030;
        --dark: #141210;
        --success: #2d6a4f;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Outfit', sans-serif;
        font-weight: 300;
    }

    .edit-topbar {
        background: var(--dark);
        padding: 0 2rem;
        display: flex;
        align-items: stretch;
        height: 56px;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 2px 16px rgba(0,0,0,0.25);
    }

    .topbar-brand {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 0.8rem;
        color: wheat;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 1;
    }

        .topbar-brand::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--gold);
            transform: rotate(45deg);
            display: inline-block;
        }

    .topbar-title {
        font-family: 'Outfit', sans-serif;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .topbar-title em {
            color: rgba(255,255,255,0.9);
            font-style: normal;
            font-weight: 500;
        }

    /* ─── LAYOUT ──────────────────────────── */
    .edit-shell {
        max-width: 860px;
        margin: 2.5rem auto;
        padding: 0 1.5rem 5rem;
    }

    .edit-header {
        margin-bottom: 2.25rem;
        animation: slideDown 0.5s ease both;
    }

    .edit-kicker {
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 600;
        margin-bottom: 0.35rem;
    }

    .edit-h1 {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        font-weight: 700;
        line-height: 1.15;
        margin: 0;
        color: var(--ink);
    }

        .edit-h1 span {
            color: var(--gold);
            font-style: italic;
        }

    /* ─── TABS ────────────────────────────── */
    .tab-nav {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--rule);
        margin-bottom: 1.75rem;
        animation: slideDown 0.5s 0.1s ease both;
        overflow-x: auto;
    }

    .tab-btn {
        background: none;
        border: none;
        padding: 0.75rem 1.5rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        cursor: pointer;
        position: relative;
        transition: color 0.2s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .tab-btn::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gold);
            transform: scaleX(0);
            transition: transform 0.25s ease;
        }

        .tab-btn.active {
            color: var(--ink);
        }

            .tab-btn.active::after {
                transform: scaleX(1);
            }

        .tab-btn:hover {
            color: var(--ink);
        }

    .tab-count {
        display: inline-block;
        background: var(--gold-pale);
        color: var(--gold);
        font-size: 0.6rem;
        font-weight: 600;
        padding: 0.1rem 0.4rem;
        border-radius: 10px;
        margin-left: 0.35rem;
        vertical-align: middle;
    }

    /* ─── PANELS ──────────────────────────── */
    .tab-panel {
        display: none;
        animation: panelIn 0.3s ease both;
    }

        .tab-panel.active {
            display: block;
        }

    @@keyframes panelIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ─── CARD ────────────────────────────── */
    .edit-card {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 2rem 2.25rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
    }

    .card-section-title {
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 600;
        margin-bottom: 1.4rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--rule);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* ─── FORM FIELDS ─────────────────────── */
    .field {
        margin-bottom: 1.35rem;
    }

        .field label {
            display: block;
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 500;
            margin-bottom: 0.4rem;
        }

        .field input,
        .field textarea {
            width: 100%;
            padding: 0.65rem 0.9rem;
            border: 1px solid var(--rule);
            border-radius: 2px;
            background: #fdfbf7;
            color: var(--ink);
            font-family: 'Outfit', sans-serif;
            font-size: 0.93rem;
            font-weight: 400;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            outline: none;
        }

            .field input:focus,
            .field textarea:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(160,120,48,0.12);
                background: #fff;
            }

            .field input.input-validation-error,
            .field textarea.input-validation-error {
                border-color: var(--danger);
            }

    .field-validation-error {
        display: block;
        font-size: 0.75rem;
        color: var(--danger);
        margin-top: 0.3rem;
    }

    .field textarea {
        resize: vertical;
        min-height: 110px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .field-row-3 {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 1rem;
    }

    /* ─── PHONE ENTRIES ───────────────────── */
    .phone-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .phone-entry {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        animation: panelIn 0.25s ease both;
    }

        .phone-entry input {
            flex: 1;
            padding: 0.65rem 0.9rem;
            border: 1px solid var(--rule);
            border-radius: 2px;
            background: #fdfbf7;
            color: var(--ink);
            font-family: 'Outfit', sans-serif;
            font-size: 0.93rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .phone-entry input:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(160,120,48,0.12);
                background: #fff;
            }

    .btn-rm {
        background: none;
        border: 1px solid #e0c0c0;
        color: var(--danger);
        border-radius: 2px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.15s, border-color 0.15s;
    }

        .btn-rm:hover {
            background: #fdecea;
            border-color: var(--danger);
        }

    .btn-add-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: none;
        border: 1px dashed var(--gold);
        color: var(--gold);
        border-radius: 2px;
        padding: 0.5rem 1.1rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.15s;
    }

        .btn-add-phone:hover {
            background: var(--gold-pale);
        }

    .phone-hint {
        font-size: 0.75rem;
        color: var(--muted);
        margin-top: 0.6rem;
        font-style: italic;
    }

    /* ─── FORM ACTIONS ────────────────────── */
    .form-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        flex-wrap: wrap;
    }

    .btn-save {
        background: var(--dark);
        color: wheat;
        border: none;
        padding: 0.8rem 2.5rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-radius: 2px;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
    }

        .btn-save:hover {
            background: var(--gold);
            color: var(--dark);
            transform: translateY(-1px);
        }

    .btn-cancel {
        font-size: 0.78rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: color 0.2s;
    }

        .btn-cancel:hover {
            color: var(--ink);
        }

    .save-note {
        font-size: 0.72rem;
        color: var(--muted);
        margin-left: auto;
        font-style: italic;
    }

    /* ─── ANIMATIONS ──────────────────────── */
    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 620px) {
        .field-row, .field-row-3 {
            grid-template-columns: 1fr;
        }

        .edit-card {
            padding: 1.5rem 1.25rem;
        }

        .topbar-title {
            display: none;
        }
    }
</style>

<div class="edit-topbar">
    <div class="topbar-brand">Hotel System Industry</div>
    <div class="topbar-title">
        Edytujesz: <em>@Model.Name</em>
    </div>
</div>

<div class="edit-shell">

    <div class="edit-header">
        <p class="edit-kicker">Panel edycji</p>
        <h1 class="edit-h1">Edytuj <span>@Model.Name</span></h1>
    </div>

    @using (Html.BeginForm("Edit", "Hotels", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="tab-nav">
            <button type="button" class="tab-btn active" onclick="switchTab('hotel', this)">
                🏨 Hotel
            </button>
            <button type="button" class="tab-btn" onclick="switchTab('address', this)">
                📍 Adres
            </button>
            <button type="button" class="tab-btn" onclick="switchTab('phones', this)">
                ☎ Telefony <span class="tab-count" id="phoneCount">@Model.PhoneNumbers.Count</span>
            </button>
        </div>

        <div class="tab-panel active" id="panel-hotel">
            <div class="edit-card">
                <div class="card-section-title">Dane podstawowe hotelu</div>

                <div class="field">
                    @Html.LabelFor(m => m.Name, "Nazwa hotelu")
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "np. Hotel Royal" })
                    @Html.ValidationMessageFor(m => m.Name)
                </div>

                <div class="field">
                    @Html.LabelFor(m => m.Email, "Adres e-mail")
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "kontakt@hotel.pl" })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>

                <div class="field">
                    @Html.LabelFor(m => m.Description, "Opis hotelu")
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Opis oferty, udogodnień..." })
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>
        </div>

        <div class="tab-panel" id="panel-address">
            <div class="edit-card">
                <div class="card-section-title">Adres hotelu</div>

                <div class="field">
                    @Html.LabelFor(m => m.Address.Street, "Ulica i numer")
                    @Html.TextBoxFor(m => m.Address.Street, new { @class = "form-control", placeholder = "ul. Marszałkowska 10" })
                    @Html.ValidationMessageFor(m => m.Address.Street)
                </div>

                <div class="field-row">
                    <div class="field">
                        @Html.LabelFor(m => m.Address.City, "Miasto")
                        @Html.TextBoxFor(m => m.Address.City, new { @class = "form-control", placeholder = "Warszawa" })
                        @Html.ValidationMessageFor(m => m.Address.City)
                    </div>
                    <div class="field">
                        @Html.LabelFor(m => m.Address.PostalCode, "Kod pocztowy")
                        @Html.TextBoxFor(m => m.Address.PostalCode, new { @class = "form-control", placeholder = "00-001" })
                        @Html.ValidationMessageFor(m => m.Address.PostalCode)
                    </div>
                </div>

                <div class="field">
                    @Html.LabelFor(m => m.Address.Country, "Kraj")
                    @Html.TextBoxFor(m => m.Address.Country, new { @class = "form-control", placeholder = "Polska" })
                    @Html.ValidationMessageFor(m => m.Address.Country)
                </div>
            </div>
        </div>

        <div class="tab-panel" id="panel-phones">
            <div class="edit-card">
                <div class="card-section-title">Numery telefonów</div>

                <div class="phone-list" id="phoneList">
                    @{
                        int pi = 0;
                    }
                    @foreach (var phone in Model.PhoneNumbers)
                    {
                        <div class="phone-entry">
                            <input type="hidden" name="PhoneNumbers[@pi].Id" value="@phone.Id" />
                            <input type="text"
                                   name="PhoneNumbers[@pi].PhoneNumber"
                                   value="@phone.PhoneNumber"
                                   placeholder="+48 22 000 00 00" />
                            <button type="button" class="btn-rm" onclick="removePhone(this)" title="Usuń">&#215;</button>
                        </div>
                        pi++;
                    }
                    @if (!Model.PhoneNumbers.Any())
                    {
                        <div class="phone-entry">
                            <input type="text" name="PhoneNumbers[0].PhoneNumber" placeholder="+48 22 000 00 00" />
                            <button type="button" class="btn-rm" onclick="removePhone(this)" title="Usuń">&#215;</button>
                        </div>
                    }
                </div>

                <button type="button" class="btn-add-phone" onclick="addPhone()">&#43; Dodaj numer</button>
                <p class="phone-hint">Istniejące numery zostaną zastąpione po zapisaniu.</p>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">Zapisz zmiany</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">&#8592; Anuluj</a>
            <span class="save-note">Zmiany dotyczą wszystkich zakładek</span>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ── Tab switching ──────────────────────────────
        function switchTab(name, btn) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('panel-' + name).classList.add('active');
            btn.classList.add('active');
        }

        // ── Phone management ───────────────────────────
        function currentPhoneCount() {
            return document.querySelectorAll('#phoneList .phone-entry').length;
        }

        function updatePhoneCount() {
            const badge = document.getElementById('phoneCount');
            const count = document.querySelectorAll(
                '#phoneList .phone-entry input[type="text"]'
            ).filter ? [...document.querySelectorAll(
                '#phoneList .phone-entry input[type="text"]'
            )].filter(i => i.value.trim() !== '').length
              : document.querySelectorAll('#phoneList .phone-entry').length;

            badge.textContent = document.querySelectorAll('#phoneList .phone-entry').length;
        }
        function reindex() {
            document.querySelectorAll('#phoneList .phone-entry').forEach((entry, i) => {
                const hidden = entry.querySelector('input[type="hidden"]');
                const text   = entry.querySelector('input[type="text"]');
                if (hidden) hidden.name = `PhoneNumbers[${i}].Id`;
                if (text)   text.name   = `PhoneNumbers[${i}].PhoneNumber`;
            });
            updatePhoneCount();
        }
        function addPhone() {
            const list  = document.getElementById('phoneList');
            const idx   = list.querySelectorAll('.phone-entry').length;
            const entry = document.createElement('div');
            entry.className = 'phone-entry';
            entry.innerHTML = `
                <input type="text"
                       name="PhoneNumbers[${idx}].PhoneNumber"
                       placeholder="+48 22 000 00 00" />
                <button type="button" class="btn-rm" onclick="removePhone(this)" title="Usuń">&#215;</button>
            `;
            list.appendChild(entry);
            entry.querySelector('input').focus();
            reindex();
        }
        function removePhone(btn) {
            const list = document.getElementById('phoneList');
            if (list.querySelectorAll('.phone-entry').length === 1) {
                btn.previousElementSibling.value = '';
                return;
            }
            btn.closest('.phone-entry').remove();
            reindex();
        }
        // Init counter
        document.addEventListener('DOMContentLoaded', updatePhoneCount);
    </script>
}
