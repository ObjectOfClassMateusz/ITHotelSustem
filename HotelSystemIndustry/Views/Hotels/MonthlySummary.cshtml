@model HotelSystemIndustry.Models.ViewModels.MonthlySummaryVM
@{
    ViewData["Title"] = $"Sprawozdanie {Model.MonthName} {Model.Year} — {Model.HotelName}";
    var months = System.Globalization.CultureInfo.GetCultureInfo("pl-PL").DateTimeFormat.MonthNames
                    .Where(m => !string.IsNullOrEmpty(m))
                    .Select((m, i) => new { Name = char.ToUpper(m[0]) + m[1..], Index = i + 1 })
                    .ToList();
}

<style>
    import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap');

    :root {
        --bg:       #0f0f12;
        --surface:  #17171d;
        --surface2: #1e1e27;
        --border:   #2a2a38;
        --border2:  #353548;
        --gold:     #d4a843;
        --gold-dim: #8a6c28;
        --text:     #e8e6f0;
        --muted:    #6b6880;
        --success:  #4ac18e;
        --danger:   #c15a4a;
        --warn:     #e6923a;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Syne', sans-serif;
        min-height: 100vh;
    }

    /* ── TOPBAR ───────────────────────────── */
    .topbar {
        height: 56px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        gap: 1rem;
        position: sticky;
        top: 0;
        z-index: 50;
    }

    .topbar-brand {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }
    .topbar-brand::before {
        content: '';
        width: 6px; height: 6px;
        background: var(--gold);
        transform: rotate(45deg);
        flex-shrink: 0;
    }

    .topbar-sep { width: 1px; height: 28px; background: var(--border); flex-shrink: 0; }

    .topbar-crumb {
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem;
        color: var(--muted);
        white-space: nowrap;
    }
    .topbar-crumb em { color: var(--text); font-style: normal; font-weight: 600; }

    .topbar-actions { margin-left: auto; display: flex; gap: 0.5rem; }

    .tb-link {
        font-family: 'DM Mono', monospace;
        font-size: 0.68rem;
        color: var(--muted);
        text-decoration: none;
        padding: 0.38rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: 3px;
        background: var(--surface2);
        transition: color 0.15s, border-color 0.15s;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        font-size: 0.68rem;
    }
    .tb-link:hover { color: var(--gold); border-color: var(--gold-dim); text-decoration: none; }

    .tb-link.gold {
        background: var(--gold);
        color: #0f0f12;
        border-color: var(--gold);
        font-weight: 700;
    }
    .tb-link.gold:hover { background: #e6ba55; border-color: #e6ba55; color: #0f0f12; }

    /* ── SHELL ────────────────────────────── */
    .shell {
        max-width: 960px;
        margin: 2.5rem auto;
        padding: 0 1.5rem 5rem;
    }

    /* ── PAGE HEADER ──────────────────────── */
    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        animation: fadeDown 0.4s ease both;
    }

    .page-kicker {
        font-family: 'DM Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold-dim);
        margin-bottom: 0.3rem;
    }

    .page-h1 {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 800;
        line-height: 1.1;
    }
    .page-h1 em { font-style: italic; color: var(--gold); font-weight: 400; }

    /* ── DATE PICKER ──────────────────────── */
    .date-picker {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        animation: fadeDown 0.4s 0.05s ease both;
    }

    .date-select {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: 'DM Mono', monospace;
        font-size: 0.78rem;
        padding: 0.45rem 0.85rem;
        border-radius: 3px;
        outline: none;
        cursor: pointer;
        appearance: none;
        transition: border-color 0.2s;
    }
    .date-select:focus { border-color: var(--gold); }

    .btn-go {
        background: var(--gold);
        color: #0f0f12;
        border: none;
        padding: 0.45rem 1.1rem;
        font-family: 'Syne', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        border-radius: 3px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .btn-go:hover { background: #e6ba55; }

    /* ── KPI GRID ─────────────────────────── */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
        animation: fadeUp 0.4s 0.08s ease both;
    }

    .kpi-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1.25rem 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
    }
    .kpi-card.blue::before   { background: #4a7fc1; }
    .kpi-card.green::before  { background: var(--success); }
    .kpi-card.gold::before   { background: var(--gold); }
    .kpi-card.orange::before { background: var(--warn); }

    .kpi-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.58rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.5rem;
    }

    .kpi-val {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
    }
    .kpi-card.blue .kpi-val   { color: #6a9fd8; }
    .kpi-card.green .kpi-val  { color: var(--success); }
    .kpi-card.gold .kpi-val   { color: var(--gold); }
    .kpi-card.orange .kpi-val { color: var(--warn); }

    .kpi-sub {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        color: var(--muted);
    }

    /* ── TABLE CARD ───────────────────────── */
    .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        animation: fadeUp 0.4s 0.14s ease both;
    }

    .table-card-header {
        padding: 1rem 1.5rem;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .table-card-title {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 700;
    }

    .res-table {
        width: 100%;
        border-collapse: collapse;
    }

    .res-table th {
        font-family: 'DM Mono', monospace;
        font-size: 0.56rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 500;
        padding: 0.7rem 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border2);
        background: var(--surface2);
        white-space: nowrap;
    }
    .res-table th:last-child { text-align: right; }

    .res-table td {
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.85rem;
        vertical-align: middle;
    }
    .res-table tr:last-child td { border-bottom: none; }
    .res-table tr:hover td { background: rgba(212,168,67,0.03); }

    .room-tag {
        display: inline-block;
        background: var(--surface2);
        border: 1px solid var(--border2);
        color: var(--gold);
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        padding: 0.18rem 0.55rem;
        border-radius: 2px;
    }

    .nights-tag {
        display: inline-block;
        background: rgba(74,193,142,0.1);
        color: var(--success);
        border: 1px solid rgba(74,193,142,0.2);
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        padding: 0.18rem 0.5rem;
        border-radius: 2px;
    }

    .rev-val {
        font-family: 'DM Mono', monospace;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--gold);
        text-align: right;
    }

    .guests-text {
        font-family: 'DM Mono', monospace;
        font-size: 0.68rem;
        color: var(--muted);
    }

    /* ── TABLE FOOTER ─────────────────────── */
    .table-footer {
        padding: 0.85rem 1.5rem;
        background: var(--surface2);
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .footer-total-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .footer-total-val {
        font-family: 'DM Mono', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--gold);
    }

    /* ── EMPTY STATE ──────────────────────── */
    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--muted);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    /* ── ANIMATIONS ───────────────────────── */
    @@keyframes fadeDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 720px) {
        .kpi-grid { grid-template-columns: 1fr 1fr; }
        .topbar-crumb { display: none; }
        .res-table th:nth-child(6),
        .res-table td:nth-child(6) { display: none; }
    }
    @@media (max-width: 480px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="topbar">
    <div class="topbar-brand">Hotel System Industry</div>
    <div class="topbar-sep"></div>
    <div class="topbar-crumb">
        Sprawozdanie &rsaquo; <em>@Model.HotelName</em>
    </div>
    <div class="topbar-actions">
        <form asp-action="MonthlySummaryDownload" asp-controller="Hotels" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="hotelId" value="@Model.HotelId" />
            <input type="hidden" name="month"   value="@Model.Month" />
            <input type="hidden" name="year"    value="@Model.Year" />
            <button type="submit" class="tb-link gold">
                ⬇ Pobierz PDF
            </button>
        </form>
        <a asp-action="Calendar" asp-route-id="@Model.HotelId" class="tb-link">
            &#9670; Kalendarz
        </a>
    </div>
</div>

<div class="shell">
    <div class="page-header">
        <div>
            <p class="page-kicker">&#9670; @Model.HotelName</p>
            <h1 class="page-h1">Sprawozdanie <em>@Model.MonthName @Model.Year</em></h1>
        </div>

        <form method="get" asp-action="MonthlySummary" asp-controller="Hotels"
              class="date-picker">
            <input type="hidden" name="hotelId" value="@Model.HotelId" />
            <select name="month" class="date-select">
                @foreach (var m in months)
                {
                    @if (m.Index == Model.Month)
                    {
                        <option value="@m.Index" selected> @m.Name</option>
                    }
                    else
                    {
                        <option value="@m.Index">@m.Name </option>
                    }
                }
            </select>
            <select name="year" class="date-select">
                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
                {
                    @if (y == Model.Year)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
            <button type="submit" class="btn-go">Pokaż</button>
        </form>
    </div>

    @* KPI TILES *@
    <div class="kpi-grid">
        <div class="kpi-card blue">
            <div class="kpi-label">Rezerwacje</div>
            <div class="kpi-val">@Model.TotalReservations</div>
            <div class="kpi-sub">@Model.TotalNights nocy łącznie</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-label">Goście</div>
            <div class="kpi-val">@Model.TotalGuests</div>
            <div class="kpi-sub">unikalnych gości</div>
        </div>
        <div class="kpi-card gold">
            <div class="kpi-label">Przychód</div>
            <div class="kpi-val">@Model.TotalRevenue.ToString("C")</div>
            <div class="kpi-sub">suma miesięczna</div>
        </div>
        <div class="kpi-card orange">
            <div class="kpi-label">Śr. pobyt</div>
            <div class="kpi-val">@Model.AvgStayLength.ToString("F1")</div>
            <div class="kpi-sub">nocy / rezerwacja</div>
        </div>
    </div>

    @* RESERVATIONS TABLE *@
    <div class="table-card">
        <div class="table-card-header">
            <span class="table-card-title">
                Rezerwacje w @Model.MonthName @Model.Year
                (@Model.Reservations.Count)
            </span>
        </div>

        @if (Model.Reservations.Any())
        {
            <table class="res-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Pokój</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Noce</th>
                        <th>Goście</th>
                        <th style="text-align:right;">Przychód</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var r in Model.Reservations.OrderBy(r => r.CheckIn))
                    {
                        <tr>
                            <td style="color:var(--muted);font-family:'DM Mono',monospace;font-size:0.7rem;">
                                @rowNum
                            </td>
                            <td><span class="room-tag">#@r.RoomNumber</span></td>
                            <td style="font-family:'DM Mono',monospace;font-size:0.8rem;">
                                @r.CheckIn.ToString("dd.MM.yyyy")
                            </td>
                            <td style="font-family:'DM Mono',monospace;font-size:0.8rem;">
                                @r.CheckOut.ToString("dd.MM.yyyy")
                            </td>
                            <td><span class="nights-tag">@r.Nights n</span></td>
                            <td><span class="guests-text">@r.GuestNames</span></td>
                            <td class="rev-val">@r.Revenue.ToString("C")</td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>

            <div class="table-footer">
                <span class="footer-total-label">
                    @Model.TotalReservations rez. &nbsp;·&nbsp;
                    @Model.TotalNights nocy &nbsp;·&nbsp;
                    @Model.TotalGuests gości
                </span>
                <span class="footer-total-val">@Model.TotalRevenue.ToString("C")</span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span style="font-size:2.5rem;">📭</span>
                <span style="font-size:1rem;font-weight:700;color:var(--text);">
                    Brak rezerwacji w @Model.MonthName @Model.Year
                </span>
                <span style="font-size:0.8rem;">
                    Wybierz inny miesiąc lub dodaj rezerwacje w kalendarzu.
                </span>
            </div>
        }
    </div>
</div>
