@using HotelSystemIndustry.Models.Kitchen
@model HotelSystemIndustry.ViewModels.Kitchen.KitchenRecipeEditViewModel

@{
    ViewData["Title"] = "Create";

    var articles = (IList<KitchenArticle>)ViewBag.Articles;
}

<h1>Create</h1>

<h4>KitchenRecipe</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OutcomeProductId" class="control-label"></label>
                <select asp-for="OutcomeProductId" class ="form-control" asp-items="ViewBag.OutcomeProductId"></select>
                <span asp-validation-for="OutcomeProductId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content" class="control-label"></label>
                <input asp-for="Content" class="form-control" />
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <h2>Ingredients</h2>
            <ul>
            @for (var i = 0; i < Model.Ingredients.Count; i++) {
                @Html.HiddenFor(m => m.Ingredients[i].ArticleId)
                @Html.HiddenFor(m => m.Ingredients[i].Count)

                <li>
                    @{
                        var ing = Model.Ingredients[i];
                        var article = articles.FirstOrDefault(a => a.Id == ing.ArticleId);
                        var name = article != null ? article.Name : "";
                        var unit = article != null ? article.Unit : ArticleUnit.Pieces;
                    }

                    <div class="row align-items-center">
                        <div class="col-md-7 text-start">@name</div> <div class="col-md-3 text-end">@ing.Count @Html.DisplayFor(m => unit)</div>

                        <div class="col-md-1 my-1"><input type="submit" asp-action="CreateRemoveIngredient" class="btn btn-danger" value="x" asp-route-index="@i" /></div>
                    </div>
                </li>
            }
            </ul>


            <h3>New ingredient</h3>

            <div class="form-group">
                <label asp-for="NewIngredient.ArticleId" class="control-label"></label>
                <select asp-for="NewIngredient.ArticleId" class ="form-control" asp-items="ViewBag.ArticleList"></select>
                <span asp-validation-for="NewIngredient.ArticleId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NewIngredient.Count" class="control-label"></label>
                <input asp-for="NewIngredient.Count" class ="form-control" >
                <span asp-validation-for="NewIngredient.Count" class="text-danger"></span>
            </div>
            <div class="form-group my-4">
                <input type="submit" asp-action="CreateAddIngredient" value="Add" class="btn btn-primary" />
            </div>

            <hr />


            <div class="form-group my-4">
                <input type="submit" asp-action="Create" value="Create" class="btn btn-success" />
            </div>
            
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

