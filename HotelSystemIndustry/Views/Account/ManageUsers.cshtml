@using HotelSystemIndustry.ViewModels
@using Microsoft.AspNetCore.Components.Forms

@model UserManagementModel

@{
    ViewData["Title"] = "Manage users";
    var queryModel = (UserQueryModel)ViewBag.UserQueryModel;
}


<div>
    <h2>Manage users</h2>
    <hr />

    <form method="get" class="row">
        <div class="col-md-4">
            <input name="FullNameFilter" value="@queryModel.FullNameFilter" class="form-control" placeholder="Filter full name" />
        </div>

        <div class="col-md-4">
            <input name="EmailFilter" value="@queryModel.EmailFilter" class="form-control" placeholder="Filter email" />
        </div>

        <div class="col-md-2">
            <button class="btn btn-primary" type="submit">Apply</button>
        </div>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>
                    Full name
                </th>
                <th>
                    Email
                </th>
                <th>
                    Email verified
                </th>
                <th>
                    Roles
                </th>
                <th></th>
                <th></th>
            </tr>
        </thead>

        @foreach (var user in Model.Users) {
            <tr>
                <td>
                    @Html.DisplayFor(m => user.FullName)
                </td>
                <td>
                    @Html.DisplayFor(m => user.Email)
                </td>
                <td>
                    @Html.DisplayFor(m => user.EmailVerified)
                </td>
                <td>
                    <ul>
                        @foreach (var role in user.Roles) {
                            <li>
                                @Html.DisplayFor(m => role)
                            </li>
                        }
                        @if (user.Roles.Count == 0) {
                            <li>Normal customer user</li>
                        }
                    </ul>
                </td>
                <td>
                    <form method="post" asp-controller="Account" asp-action="ManageRoles" asp-route-id="@user.Id" class="col-sm-6">
                        @Html.AntiForgeryToken()
                        <input type="submit" value="Manage roles" class="btn btn-primary" />
                    </form>
                </td>
                <td>
                    <form method="post" asp-controller="Account" asp-action="ConfirmUserDeleteByAdmin" asp-route-id="@user.Id">
                        @Html.AntiForgeryToken()
                        <input type="submit" value="Delete" class="btn btn-danger"/>
                    </form>
                </td>
            </tr>
        }

    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
