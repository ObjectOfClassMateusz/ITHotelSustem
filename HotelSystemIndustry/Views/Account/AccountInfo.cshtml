@using HotelSystemIndustry.Infrastructure
@using Microsoft.AspNetCore.Identity

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Manage account";

    var user = await UserManager.GetUserAsync(User);
    var fullName = user != null ? user.FullName : "";

    var roles = await UserManager.GetRolesAsync(user!);
}

<head>
    <link rel="stylesheet" href="~/css/accountInfo.css" asp-append-version="true" />
</head>

<div class="account-page">
    <div class="account-card">
        <div class="account-header">
            <div class="header-text">
                <p class="header-eyebrow">Profil użytkownika</p>
                <div class="header-name">@fullName</div>
            </div>
        </div>
        @* Body *@
        <div class="account-body">
            <div class="info-block">
                <div class="block-label">Dane konta</div>

                <div class="info-row">
                    <span class="info-key">Nazwa</span>
                    <span class="info-val">@fullName</span>
                </div>
                <div class="info-row">
                    <span class="info-key">E-mail</span>
                    <span class="info-val">@user!.Email</span>
                </div>
            </div>
            @* Roles *@
            <div class="roles-block">
                <div class="block-label">Uprawnienia</div>
                @if (roles.Count > 0)
                {
                    <ul class="roles-list">
                        @foreach (var role in roles)
                        {
                            <li class="role-chip">@role</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="customer-badge">
                        ✦ Konto standardowe
                    </div>
                }
            </div>

        </div>
        <div class="account-footer">
            <a class="change-pwd-link"
               asp-controller="Account"
               asp-action="ChangePassword">
                Zmień hasło
                <span class="arrow">&#8594;</span>
            </a>
        </div>

    </div>
</div>