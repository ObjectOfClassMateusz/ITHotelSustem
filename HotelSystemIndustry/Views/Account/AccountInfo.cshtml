@using HotelSystemIndustry.Infrastructure
@using Microsoft.AspNetCore.Identity

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Manage account";

    var user = await UserManager.GetUserAsync(User);
    var fullName = user != null ? user.FullName : "";

    var roles = await UserManager.GetRolesAsync(user!);
}


<div class="row">
    <div class="col-md-6">
        <section>
            <h2 class=text-center mb-4>Account Info</h2>

            <dl class="row">
                <dt class="col-sm-2">
                    Full name:
                </dt>
                <dd class="col-sm-10">
                    @fullName
                </dd>

                <dt class="col-sm-2">
                    Email:
                </dt>
                <dd class="col-sm-10">
                    @user!.Email
                </dd>
            </dl>

            @if (roles.Count > 0) {
                <hr />
                <h3 class="text-center mb-2">Roles</h3>

                <ul>
                    @foreach (var role in roles) {
                        <li>@role</li>
                    }
                </ul>
            }
            else
            {
                <p>Normal customer account</p>
            }

            <hr />

            <a class="nav-link" id="change-password" asp-controller="Account" asp-action="ChangePassword">Change password</a>
        </section>
    </div>
</div>
