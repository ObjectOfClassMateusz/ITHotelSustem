@using HotelSystemIndustry.ViewModels

@model UserManagementInfo

@{
    ViewData["Title"] = "Potwierdź usunięcie użytkownika";
}

<div>
    <h2>Czy na pewno chcesz usunąć tego użytkownika?</h2>
    <hr />

    <dl>
        <div class="row">
            <dt class="col-md-2">
                Pełna nazwa:
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.FullName)
            </dd>
        </div>

        <div class="row">
            <dt class="col-md-2">
                E-mail: 
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.Email)
            </dd>
        </div>
            
        <div class="row">
            <dt class="col-md-2">
                E-mail zweryfikowany:
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.EmailVerified)
            </dd>
        </div>

        <div class="row">
        <dt class="col-md-2">
            Role:
        </dt>
        <dd class="col-md-4">
            <ul>
                @foreach (var role in Model.Roles) {
                    <li>@role</li>
                }
                @if (Model.Roles.Count == 0) {
                    <li>Zwyczajne konto użytkownika</li>
                }
            </ul>
        </dd>
        </div>
    </dl>

    <div class="row">
        <form method="post" asp-controller="Account" asp-action="DeleteUserByAdmin" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <input type="submit" value="Usuń" class="btn btn-danger"/>

            <a asp-controller="Account" asp-action="ManageUsers">Wróć</a>
        </form>
    </div>
</div>
