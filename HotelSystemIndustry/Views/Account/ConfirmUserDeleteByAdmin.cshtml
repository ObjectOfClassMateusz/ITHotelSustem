@using HotelSystemIndustry.ViewModels

@model UserManagementInfo

@{
    ViewData["Title"] = "Confirm user delete";
}

<div>
    <h2>Are you sure you want to delete this user?</h2>
    <hr />

    <dl>
        <div class="row">
            <dt class="col-md-2">
                Full name:
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.FullName)
            </dd>
        </div>

        <div class="row">
            <dt class="col-md-2">
                Email: 
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.Email)
            </dd>
        </div>
            
        <div class="row">
            <dt class="col-md-2">
                Email verified:
            </dt>
            <dd class="col-md-4">
                @Html.DisplayFor(m => Model.EmailVerified)
            </dd>
        </div>

        <div class="row">
        <dt class="col-md-2">
            Roles:
        </dt>
        <dd class="col-md-4">
            <ul>
                @foreach (var role in Model.Roles) {
                    <li>@role</li>
                }
                @if (Model.Roles.Count == 0) {
                    <li>Normal customer account</li>
                }
            </ul>
        </dd>
        </div>
    </dl>

    <div class="row">
        <form method="post" asp-controller="Account" asp-action="DeleteUserByAdmin" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <input type="submit" value="Delete" class="btn btn-danger"/>

            <a asp-controller="Account" asp-action="ManageUsers">Back</a>
        </form>
    </div>
</div>
