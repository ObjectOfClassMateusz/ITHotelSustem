@model HotelSystemIndustry.Models.Events.EventHall

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>EventHall</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumMaxGuests" class="control-label"></label>
                <input asp-for="NumMaxGuests" class="form-control" />
                <span asp-validation-for="NumMaxGuests" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HotelId" class="control-label"></label>
                <select asp-for="HotelId" class ="form-control" asp-items="ViewBag.HotelId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ReservationPrice" class="control-label"></label>
                <input asp-for="ReservationPrice" class="form-control" />
                <span asp-validation-for="ReservationPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

