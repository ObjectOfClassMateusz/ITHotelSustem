@using HotelSystemIndustry.Models.Kitchen
@using HotelSystemIndustry.Services

@model IList<ExternalMealArea>

@{
    ViewData["Title"] = "Specjalne przepisy zewnętrzne";
    ViewBag.LowerNavPartial = "_KitchenNavPartial";
}


<h1 class="fs-2">Specjalne przepisy zewnętrzne</h1>
<h2 class="fs-1">Znajdź danie pochodzące z regionu:</h2>
<hr />


<div class="container my-4">
    @foreach (var area in Model) {
        <div class="container my-4">
            <h3 class="my-4">@area.StrArea</h3>

            <div class="my-4">
                <span class="fw-bold">Kraj:</span> @area.StrCountry
            </div>

            <div class="my-4">
                <a class="btn btn-primary" asp-action="SpecialDishesOfArea" asp-route-area="@area.StrArea">Pokaż</a>
            </div>

            <hr />
        </div>
    }
</div>


<div class="my-4">
    <a asp-action="SpecialDishInspiration" asp-controller="Kitchen" class="btn btn-primary">Wróć</a>
</div>

