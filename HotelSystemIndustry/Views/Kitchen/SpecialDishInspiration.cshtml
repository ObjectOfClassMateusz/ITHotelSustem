@using HotelSystemIndustry.Models.Kitchen


@{
    ViewData["Title"] = "Special dish inspirations";
    ViewBag.LowerNavPartial = "_KitchenNavPartial";
}


<h1>Find an interesting dish</h1>
<hr />


<div class="container my-4">
    <div class="row justify-content-center my-4">

        <div class="col-md-4 text-center my-2">
            <a asp-action="SearchForDishCategory" class="page-link text-dark">Search by category</a>
        </div>

        <div class="col-md-4 text-center my-2">
            <a asp-action="SearchForDishArea" class="page-link text-dark">Search by area</a>
        </div>

        <div class="col-md-4 text-center my-2">
            <a asp-action="SearchForDishByName" class="page-link text-dark">Search by name</a>
        </div>

        <div class="col-md-4 text-center my-2">
            <a asp-action="RandomSpecialDish" class="page-link text-dark">Random</a>
        </div>

    </div>
</div>

<div class="my-4">
    <a asp-action="Index" asp-controller="Kitchen" class="btn btn-primary">Back</a>
</div>

