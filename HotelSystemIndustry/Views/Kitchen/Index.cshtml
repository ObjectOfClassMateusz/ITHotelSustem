
@{
    ViewData["Title"] = "Kitchen";
    ViewBag.LowerNavPartial = "_KitchenNavPartial";
}


<h1>Orders</h1>


<div class="row justify-content-center my-4">

    <div class="col-md-4 text-center my-2">
        <a asp-action="PlaceOrder" class="page-link text-dark">Place an Order</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="RealiseOrderView" class="page-link text-dark">Realise Order</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="CancelOrderView" class="page-link text-dark">Cancel Order</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="HandleDelivery" class="page-link text-dark">Handle Delivery</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="ChooseProductCookingHelp" class="page-link text-dark">Cooking Help</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="SpecialDishInspiration" class="page-link text-dark">Looking for an inspiration?</a>
    </div>

</div>


<hr />


<form id="hotelchangeform" class="form-group row my-4 justify-content-center">

    <div class="col-md-1">
        <label class="control-label fs-6" for="hotelid">Hotel:</label>
    </div>
    <div class="col-md-4">
        <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
    </div>

</form>



<h2>
    Management
</h2>

<hr />

<ul>
    <li>
        <a asp-controller="KitchenArticleType" asp-action="Index">Types of articles</a>
    </li>

    <li>
        <a asp-controller="KitchenArticle" asp-action="Index">Articles</a>
    </li>

    <li>
        <a asp-controller="ArticleInstance" asp-action="Index">Instances of articles</a>
    </li>

    <li>
        <a asp-controller="KitchenProduct" asp-action="Index">Kitchen products</a>
    </li>

    <li>
        <a asp-controller="KitchenRecipe" asp-action="Index">Recipes</a>
    </li>

    <li>
        <a asp-controller="Order" asp-action="Index">Orders</a>
    </li>
</ul>


@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#hotelid").change(function (e){
                e.preventDefault();
                let data = new FormData();
                data.append("hotelid", $("#hotelid").val());
                $.ajax({
                    url: '/HotelChange/ChangeHotel',
                    type: "POST",
                    processData: false,
                    data: data,
                    dataType: 'json',
                    contentType: false,
                    success: function (response) {
                        console.log('Changed hotel');
                    },
                    error: function (er) { console.log(er); }
                });

                return false;
            });
        });
    </script>
}


