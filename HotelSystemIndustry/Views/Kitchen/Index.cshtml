
@{
    ViewData["Title"] = "Kuchnia";
    ViewBag.LowerNavPartial = "_KitchenNavPartial";
}


<h1>Zamówienia</h1>


<div class="row justify-content-center my-4">

    <div class="col-md-4 text-center my-2">
        <a asp-action="PlaceOrder" class="page-link text-dark">Złóż zamówienie</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="RealiseOrderView" class="page-link text-dark">Zrealizuj zamówienie</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="CancelOrderView" class="page-link text-dark">Anuluj zamówienie</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="HandleDelivery" class="page-link text-dark">Zarejestruj dostawę artykułów</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="ChooseProductCookingHelp" class="page-link text-dark">Pomoc kucharska</a>
    </div>

    <div class="col-md-4 text-center my-2">
        <a asp-action="SpecialDishInspiration" class="page-link text-dark">Zewnętrzne przepisy</a>
    </div>

</div>


<hr />


<form id="hotelchangeform" class="form-group row my-4 justify-content-center">

    <div class="col-md-1">
        <label class="control-label fs-6" for="hotelid">Hotel:</label>
    </div>
    <div class="col-md-4">
        <select asp-items="ViewBag.HotelChangePartialHotelList" name="hotelid" id="hotelid" class="form-control"></select>
    </div>

</form>



<h2>
    Zarządzanie
</h2>

<hr />

<ul>
    <li>
        <a asp-controller="KitchenArticleType" asp-action="Index">Typy artykułów</a>
    </li>

    <li>
        <a asp-controller="KitchenArticle" asp-action="Index">Artykuły</a>
    </li>

    <li>
        <a asp-controller="ArticleInstance" asp-action="Index">Wystąpienia artykułów</a>
    </li>

    <li>
        <a asp-controller="KitchenProduct" asp-action="Index">Dania</a>
    </li>

    <li>
        <a asp-controller="KitchenRecipe" asp-action="Index">Przepisy</a>
    </li>

    <li>
        <a asp-controller="Storage" asp-action="Index">Miejsca, w których przechowywane są artykuły</a>
    </li>

    <li>
        <a asp-controller="Order" asp-action="Index">Zamówienia</a>
    </li>
</ul>


@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#hotelid").change(function (e){
                e.preventDefault();
                let data = new FormData();
                data.append("hotelid", $("#hotelid").val());
                $.ajax({
                    url: '/HotelChange/ChangeHotel',
                    type: "POST",
                    processData: false,
                    data: data,
                    dataType: 'json',
                    contentType: false,
                    success: function (response) {
                        console.log('Changed hotel');
                    },
                    error: function (er) { console.log(er); }
                });

                return false;
            });
        });
    </script>
}


