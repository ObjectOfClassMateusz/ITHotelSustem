<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hotel System Industry</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/button.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelSystemIndustry.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/Layout/layout.css" asp-append-version="true" />

</head>
<body>
    <header class="bg-goldyellow">
        <nav class="navbar navbar-toggleable-sm border-bottom box-shadow mb-3 navbar-light">
            <div class="navbar-expand-sm container-fluid">
                <a class="navbar-brand asp-link" asp-area="" asp-controller="Hotels" asp-action="Index">
                    Hotel System Industry
                </a>

                <!--<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>-->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <partial name="_MenusPartial"/>
                    <partial name="_LoginPartial"/>
                </div>
            </div>
            @if (!String.IsNullOrEmpty(ViewBag.LowerNavPartial))
            {
                <div class="navbar-expand-sm container-fluid">
                    @await Html.PartialAsync((string)ViewBag.LowerNavPartial)
                </div>
            }
        </nav>
    
    
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="navbar navbar-toggleable-sm border-top footer text-muted bg-goldyellow">
        <div class="container">
            &copy; 2026 - Hotel System Industry - 
            <a class="navbar-brand asp-link" asp-area="" asp-controller="Hotels" asp-action="Privacy">
                Polityka Prywatności
            </a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
