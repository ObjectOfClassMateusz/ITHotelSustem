@using HotelSystemIndustry.Models.Trading
@model PurchaseItem

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.SaleItem!.Name)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.SaleItem!.Name)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Variant)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Variant)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Count)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Count)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.UnitPrice)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.UnitPrice)
    </dd>

    @if (Model.SaleItem!.Type!.IsForRent) {
        <dt class="col-sm-2">
            Zwrócony po wypożyczeniu
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HasBeenReturned)
        </dd>
    } else if (Model.HasBeenReturned) {
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            Przedmiot został zwrócony
        </dd>
    }
</dl>
