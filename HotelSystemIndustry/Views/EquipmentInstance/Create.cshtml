@model HotelSystemIndustry.Models.Events.EquipmentInstance

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>EquipmentInstance</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EquipmentId" class="control-label"></label>
                <select asp-for="EquipmentId" class ="form-control" asp-items="ViewBag.EquipmentId"></select>
            </div>
            <div class="form-group">
                <label asp-for="EventHallId" class="control-label"></label>
                <select asp-for="EventHallId" class ="form-control" asp-items="ViewBag.EventHallId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ReservationPrice" class="control-label"></label>
                <input asp-for="ReservationPrice" class="form-control" />
                <span asp-validation-for="ReservationPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
